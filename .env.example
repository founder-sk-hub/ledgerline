# Copy to .env and fill in. Never commit .env.

# Meta Model API (Muse Spark) — https://dev.meta.ai
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# "Private mode": Muse Spark Open (open weights) on Baseten — https://www.baseten.co/library/muse-spark-open/
# Any OpenAI-compatible endpoint serving the open weights works (e.g. your own vLLM in a VPC).
BASETEN_API_KEY=
PRIVATE_BASE_URL=https://inference.baseten.co/v1
PRIVATE_MODEL=meta-models/muse-spark-open-1026

# replay = no keys needed, streams recorded real runs; live = calls the models
LEDGERLINE_MODE=replay

# Local spend guard (USD). Ledgerline refuses live runs once its own recorded spend reaches this.
LEDGERLINE_BUDGET_USD=40
